--smart-case
--hidden
# Follow symlinks: skipping them silently produces incomplete results with
# no warning, which is worse than occasionally searching a file twice.
--follow
--glob=!.git
--max-columns=200
--max-columns-preview
--hostname-bin=ripgrep-link-host
# File URIs carry literal filenames. This route explicitly carries diagnostic
# coordinates, including when the filename itself ends in a numeric suffix.
--hyperlink-format=nvim-remote://{host}{path}:{line}:{column}
