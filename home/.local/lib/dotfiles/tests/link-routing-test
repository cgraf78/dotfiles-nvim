#!/usr/bin/env bash
set -u
. "${BASH_SOURCE[0]%/*}/nvim/helpers.sh"
config=$HOME/.config/ripgrep/config.editor
fixture=$HOME/.local/lib/dotfiles/tests/fixtures/nvim-link-routes.tsv
nvim_test_contains 'ripgrep linkification uses the editor-owned host adapter' \
  '--hostname-bin=ripgrep-link-host' "$config"
nvim_test_assert 'ripgrep host adapter is executable' \
  test -x "$HOME/.local/bin/ripgrep-link-host"
nvim_test_assert 'link route fixture is present' test -s "$fixture"

route_check=$(_tmpdir)/route-check.py
cat >"$route_check" <<'PY'
import pathlib
import sys
import urllib.parse

fixture = pathlib.Path(sys.argv[1])
seen = []
for raw in fixture.read_text().splitlines():
    if not raw or raw.startswith("#"):
        continue
    name, uri, target, cwd, source, context = raw.split("\t")
    parsed = urllib.parse.urlsplit(uri)
    if parsed.scheme in {"nvim-open", "lazygit-edit"}:
        actual_target = urllib.parse.unquote(parsed.netloc + parsed.path)
        actual_source = "terminal"
        actual_context = "-"
    elif parsed.scheme == "file":
        actual_target = urllib.parse.unquote(parsed.path)
        if parsed.netloc in {"", "localhost"}:
            actual_source = "terminal"
            actual_context = "-"
        else:
            actual_source = "remote"
            actual_context = parsed.netloc
    else:
        raise SystemExit(f"unsupported route scheme in {name}: {parsed.scheme}")
    if (actual_target, actual_source, actual_context) != (target, source, context):
        raise SystemExit(f"route mismatch: {name}")
    if not cwd.startswith("/"):
        raise SystemExit(f"non-absolute cwd: {name}")
    seen.append(name)
print(",".join(seen))
PY
route_output=$(python3 "$route_check" "$fixture")
_assert_eq 'link route fixture executes local, Lazygit, localhost, and remote cases' \
  'local-nvim,lazygit-space,localhost-file,remote-file' "$route_output"

rg_tmp=$(_tmpdir)
rg_bin=$(_mock_bin)
rg_host_log=$rg_tmp/host-called
mkdir -p "$rg_tmp/src"
{
  for _ in {1..11}; do printf 'other\n'; done
  printf 'needle\n'
} >"$rg_tmp/src/main.lua"
cat >"$rg_bin/termnav" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$*" >"$RIPGREP_LINK_HOST_LOG"
test "$#" -eq 1 && test "$1" = link-host || exit 2
printf 'route-host.invalid\n'
EOF
chmod +x "$rg_bin/termnav"
rg_output=$(cd "$rg_tmp" && RIPGREP_LINK_HOST_LOG="$rg_host_log" \
  RIPGREP_CONFIG_PATH="$config" PATH="$rg_bin:$HOME/.local/bin:$PATH" \
  rg --color=always --with-filename -n needle src/main.lua)
_assert_eq 'ripgrep host adapter delegates to the native Termnav command' \
  'link-host' "$(<"$rg_host_log")"
_assert_contains 'ripgrep distinguishes diagnostic locations from literal file hyperlinks' \
  'nvim-remote://route-host.invalid' "$rg_output"
_assert_contains 'ripgrep hyperlink preserves the matched path and line' \
  'src/main.lua:12' "$rg_output"

# A numeric suffix in the filename must remain distinct from the appended
# diagnostic coordinates; both files may exist, so existence cannot decide it.
cp "$rg_tmp/src/main.lua" "$rg_tmp/report:2026"
cp "$rg_tmp/src/main.lua" "$rg_tmp/report"
rg_output=$(cd "$rg_tmp" && RIPGREP_LINK_HOST_LOG="$rg_host_log" \
  RIPGREP_CONFIG_PATH="$config" PATH="$rg_bin:$HOME/.local/bin:$PATH" \
  rg --color=always --with-filename -n needle report:2026)
rg_uri=$(printf '%s' "$rg_output" | python3 -c '
import re
import sys
match = re.search(r"\x1b\]8;[^;]*;([^\x1b\x07]+)", sys.stdin.read())
if match is None:
    raise SystemExit("missing OSC-8 target")
print(match.group(1))
')
rg_root=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$rg_tmp")
_assert_eq 'ripgrep preserves numeric filename suffix inside the diagnostic hyperlink' \
  "nvim-remote://route-host.invalid$rg_root/report:2026:12:1" "$rg_uri"
nvim_test_finish
