#!/usr/bin/env bash
set -u
. "${BASH_SOURCE[0]%/*}/nvim/helpers.sh"
fragment=$HOME/.config/tmux/conf.d/20-editor.conf
fragment_content=$(<"$fragment")

# The server, its panes, and every run-shell child inherit this environment.
# A bare `new-session` would start the caller's login shell, which loads live
# env.d, interactive.d, credentials, and history from the caller's HOME, so
# give tmux a fixture HOME, a plain sh, and an explicit inert pane command.
# The private socket lives one level below the runner's short system tmp
# directory because the per-suite TMPDIR can exceed the Unix socket limit.
tmux_home=$(_tmpdir)
socket_dir=$(mktemp -d "${DOT_TEST_SYSTEM_TMPDIR:-${TMPDIR:-/tmp}}/dts.XXXXXX") || {
  nvim_test_fail 'tmux editor test creates a private socket directory'
  nvim_test_finish
}
CLEANUP_DIRS+=("$socket_dir")
socket=$socket_dir/tmux.sock
tmux_env=(env -i HOME="$tmux_home" PATH="$PATH" SHELL=/bin/sh
  TERM="${TERM:-xterm-256color}" TMPDIR="${TMPDIR:-/tmp}")
# tmux needs a UTF-8 locale, and Termux supplies its root through PREFIX.
for passthrough in LANG LC_ALL LC_CTYPE PREFIX; do
  [[ -n ${!passthrough:-} ]] && tmux_env+=("$passthrough=${!passthrough}")
done
tmux_cmd() {
  "${tmux_env[@]}" tmux -S "$socket" "$@"
}
# The fragment stands alone: everything it sits beside belongs to the base
# tmux configuration and its own tests. Snapshot tmux's defaults first so the
# fragment's whole effect can be compared, however its lines are spelled.
# Each line carries its source, so a change shows which state it touched.
tmux_state() {
  {
    tmux_cmd list-keys | sed -E 's/[[:space:]]+/ /g'
    tmux_cmd show-options -g | sed 's/^/option /'
    tmux_cmd show-options -gw | sed 's/^/window-option /'
    tmux_cmd show-options -s | sed 's/^/server-option /'
    tmux_cmd show-environment -g | sed 's/^/environment /'
  } | LC_ALL=C sort
}
if ! tmux_cmd -f /dev/null new-session -d 'exec sleep 300' 2>/dev/null; then
  nvim_test_fail 'tmux editor test server starts'
  nvim_test_finish
fi
state_dir=$(_tmpdir)
tmux_state >"$state_dir/before"
if ! tmux_cmd source-file "$fragment" 2>/dev/null; then
  nvim_test_fail 'tmux accepts the editor fragment on its own'
  tmux_cmd kill-server >/dev/null 2>&1 || true
  nvim_test_finish
fi
tmux_state >"$state_dir/after"

help_keys=$(tmux_cmd list-keys -N)
for description in 'Open a file or link in Neovim' \
  'Paste through the editor terminal integration'; do
  _assert_contains "tmux editor: help shows $description" "$description" "$help_keys"
done

root_keys=$(tmux_cmd list-keys -T root | sed -E 's/^bind-key[[:space:]]+-T /bind-key -T /')
prefix_keys=$(tmux_cmd list-keys -T prefix | sed -E 's/^bind-key[[:space:]]+-T /bind-key -T /')
clipboard_paste=$(printf '%s\n' "$root_keys" |
  grep -F 'send-keys Escape [778899~' || true)
open_link=$(printf '%s\n' "$prefix_keys" | grep 'bind-key -T prefix e ' || true)

_assert_contains 'tmux editor runtime opens prompted links through the Nvim adapter' \
  'termnav nvim open link' "$open_link"
_assert_contains 'tmux editor runtime keeps the clipboard paste protocol' \
  'send-keys Escape [778899~' "$clipboard_paste"
_assert_contains 'tmux editor source assigns the clipboard protocol to C-S-v' \
  "bind -N \"Paste through the editor terminal integration\" -n C-S-v send-keys Escape '[778899~'" "$fragment_content"

# Mouse mode and pane, tab, and link routing are base policy, so the fragment
# may add exactly its two Neovim keys and change nothing else: no option, no
# environment variable, and no other binding. A redefinition here would
# silently override base on every editor host.
# Lines of the first snapshot missing from the second. awk rather than comm:
# test/run exposes a fixed command set, and comm is not part of it.
only_in() {
  awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen)' "$2" "$1"
}
removed=$(only_in "$state_dir/before" "$state_dir/after")
# tmux before 3.5 lists the Ctrl-Shift-V key as S-C-v.
added=$(only_in "$state_dir/after" "$state_dir/before" |
  awk '{ key = $4; if (key == "S-C-v") key = "C-S-v"; print $1, $2, $3, key }')
_assert_eq 'tmux editor fragment removes or changes nothing from tmux defaults' '' "$removed"
_assert_eq 'tmux editor fragment adds only its two Neovim keys' \
  $'bind-key -T prefix e\nbind-key -T root C-S-v' "$(LC_ALL=C sort <<<"$added")"

tmux_cmd kill-server >/dev/null 2>&1 || true
nvim_test_finish
