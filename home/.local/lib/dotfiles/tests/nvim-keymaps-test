#!/usr/bin/env bash
# nvim-keymaps-test — behavior tests for editor-owned keymap domains.
#
# Each case loads one keymap domain into a bare headless Neovim and drives it
# with real key input, so the mappings are exercised without the plugin graph.
# Plugin integrations (grug-far, inc-rename, Telescope, Trouble) are stubbed at
# their module or command boundary.
#
# Usage: nvim-keymaps-test

set -o pipefail
export NO_COLOR=1

# shellcheck source=nvim/helpers.sh
. "${BASH_SOURCE[0]%/*}/nvim/helpers.sh"

_require_compatible_libc "nvim-keymaps-test"
_test_managed_nvim_bin || exit 1
NVIM_TEST_BIN=$REPLY
_require_nvim_version "nvim-keymaps-test" "$NVIM_TEST_BIN"

# Resolve the config under test once, so a case may give Neovim a scratch HOME
# without also redirecting which keymap modules it loads. Neovim's require
# searches the config directory's lua/ before package.path, so pin that
# directory to the same tree.
NVIM_TEST_LUA_DIR=$HOME/.config/nvim/lua
XDG_CONFIG_HOME=$HOME/.config
export XDG_CONFIG_HOME

# Run a lua snippet in a bare headless Neovim whose package.path resolves the
# config modules under test. `-i NONE` keeps concurrent suites off the user's
# ShaDa file.
_nvim_lua() {
  "$NVIM_TEST_BIN" --headless --noplugin -u NONE -i NONE \
    -c "lua package.path='$NVIM_TEST_LUA_DIR/?.lua;' .. package.path; $1" \
    -c 'qa!' 2>&1
}

# Load the VSCode-style domain under the option values its selection helpers
# are written against, then run the case.
_nvim_vscode_keys() {
  _nvim_lua "
    vim.o.selection = 'exclusive'
    vim.o.clipboard = ''
    require('config.keymaps.vscode')
    $1
  "
}

