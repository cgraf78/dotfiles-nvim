      local mapping = vim.fn.maparg(key, mode, false, true)
      local rhs = mapping.rhs and vim.fn.keytrans(mapping.rhs) or ""
      print(key .. ":" .. mode .. ":" .. rhs .. ":" .. tostring(mapping.noremap == 0))
    end
  end
')
expected="$(printf '<C-/>:n:gcc:true\n<C-/>:x:gc:true\n<C-/>:i:<lt>Esc>gcca:true\n<C-_>:n:gcc:true\n<C-_>:x:gc:true\n<C-_>:i:<lt>Esc>gcca:true')"
_assert_eq "comments: Ctrl+/ and its legacy Ctrl-_ terminal encoding share mappings" \
  "$expected" "$result"

