#!/usr/bin/env bash
# nvim-test — unit tests for custom nvim config modules.
#
# Runs lua tests headlessly via `nvim --headless` to exercise dotfiles-owned
# Neovim config modules and integration wiring for extracted plugins.
#
# Usage: nvim-test

set -o pipefail
export NO_COLOR=1

# shellcheck source=nvim/helpers.sh
. "${BASH_SOURCE[0]%/*}/nvim/helpers.sh"

_require_compatible_libc "nvim-test"
_test_use_host_runtime_dirs || exit 1
_test_use_host_shdeps

# This suite tests Neovim configuration, not the dotfiles launcher (covered by
# core-launchers-test). Worktree runs intentionally make HOME the source tree,
# so select the already-converged host payload here instead of teaching the
# production launcher about dot test's alternate HOME.
_test_managed_nvim_bin || exit 1
NVIM_TEST_BIN=$REPLY
_require_nvim_version "nvim-test" "$NVIM_TEST_BIN"

# Resolve dependencies against the configuration under test, not the host's
# previously installed copy. This matters whenever a dotfiles branch introduces
# a new provider: the implementation may already be available in the shared
# development checkout while the live fleet configuration cannot declare it
# until the branch lands and `dot update` runs.
SHDEPS_CONF_DIR="$HOME/.config/shdeps"
export SHDEPS_CONF_DIR
_test_prefer_system_git after-dotfiles || exit 1

# Startup globals for every full-config run. Session restore stays off so a
# smoke run never rewrites the user's nvim-workspace session, and a private
# plugin copy loads only what it holds (see _test_use_host_runtime_dirs).
# LazyVim rewrites lazyvim.json beside the source config whenever its schema
# version moves, so it reads a scratch copy that carries the same extras.
# Mason stays off: a composed dev config would otherwise `go install` LSP
# tools in the background, which needs the network, makes runs depend on
# install timing, and leaves Go's read-only module cache in a fixture HOME.
NVIM_TEST_LAZYVIM_JSON=$(_tmpdir)/lazyvim.json
if [[ -f $HOME/.config/nvim/lazyvim.json ]]; then
  cp "$HOME/.config/nvim/lazyvim.json" "$NVIM_TEST_LAZYVIM_JSON" || exit 1
fi
export NVIM_TEST_LAZYVIM_JSON
NVIM_FULL_CONFIG_CMD='lua vim.g.disable_session_restore = true; vim.g.mason_disabled = true; vim.g.lazyvim_json = vim.env.NVIM_TEST_LAZYVIM_JSON'
if [[ $NVIM_TEST_PLUGIN_INSTALL_DISABLED == 1 ]]; then
  NVIM_FULL_CONFIG_CMD+='; vim.g.plugin_install_disabled = true'
fi

# Run a lua snippet headlessly in nvim. Prepends the nvim config lua dir
# to package.path so dofile'd modules can resolve their require() calls.
_nvim_lua() {
  local _lua_dir="$HOME/.config/nvim/lua"
  # Keep headless tests off the user's ShaDa file. `dot test` runs suites in
  # parallel, and concurrent nvim processes can otherwise fight over
  # ~/.local/state/nvim/shada/main.shada.
  "$NVIM_TEST_BIN" --headless --noplugin -u NONE -i NONE \
    -c "lua package.path='$_lua_dir/?.lua;' .. package.path; $1" \
    -c 'qa!' 2>&1
}

# Run a Lua probe file against the full composed config. Probes report to
# the file named by NVIM_TEST_PROBE_FILE rather than stdout, because loading
# plugins can print notifications that are environment noise here.
_nvim_full_config_probe() {
  local result_file="$1" probe_file="$2"
  NVIM_TEST_PROBE_FILE=$result_file "$NVIM_TEST_BIN" --headless -i NONE \
    --cmd "$NVIM_FULL_CONFIG_CMD" \
    -u "$HOME/.config/nvim/init.lua" \
    -c "luafile $probe_file" \
    -c 'qa!' >/dev/null 2>&1
}

# Keep one full-config smoke test in this suite. Most tests use `--noplugin`
# unit snippets for determinism, but startup/shutdown regressions usually hide
# in integration paths such as filetype, plugin loading, and workspace probes.
_nvim_startup_budget() {
  if [[ -n "${NVIM_STARTUP_BUDGET_SECONDS:-}" ]]; then
    printf '%s\n' "$NVIM_STARTUP_BUDGET_SECONDS"
  elif [[ "${DOT_TEST_PARALLEL:-0}" = 1 && "${DOT_TEST_JOBS:-1}" =~ ^[0-9]+$ && "${DOT_TEST_JOBS:-1}" -gt 1 ]]; then
    # The full config smoke test runs real startup/shutdown while dot test may
    # also be driving shell, Git, bootstrap, and editor suites. Keep direct
    # single-suite runs strict, but scale the parallel-run budget with load.
    printf '%s\n' "$((6 + DOT_TEST_JOBS * 2))"
  elif [[ -n "${WSL_DISTRO_NAME:-}" || -n "${WSL_INTEROP:-}" ]]; then
    # WSL terminal sessions can be CPU- and IO-constrained under the full
    # parallel dot test load. Keep the smoke test meaningful without making it
    # fail only because the host is busy.
    printf '15\n'
  else
    printf '6\n'
  fi
}

# The regression harness below replaces this function before invoking it.
# An empty file starts the config without opening one.
# shellcheck disable=SC2329
_run_nvim_startup() {
  local timeout_seconds="$1" file="$2"

  # The smoke test opens a fixture file and must not overwrite the user's
  # nvim-workspace session when the full config saves on VimLeavePre.
  _with_timeout "$timeout_seconds" "$NVIM_TEST_BIN" -i NONE --headless \
    --cmd "$NVIM_FULL_CONFIG_CMD" \
    ${file:+"$file"} '+qa!'
}

# Start the full config until one start succeeds within budget seconds, or
# with an empty budget until one start succeeds at all. On failure, print
# the failing start's output and return its status (124 for a timeout).
_prepare_nvim_startup() {
  local file="$1" budget="$2" remaining attempt_timeout output rc elapsed
  local timeout_expired_file timed_out
  local total_elapsed=0 deadline=120
  local timeout_retried=0

  while :; do
    remaining=$((deadline - total_elapsed))
    if [[ "$remaining" -le 0 ]]; then
      echo "startup preparation did not converge within $deadline seconds"
      return 124
    fi

    attempt_timeout=$remaining
    timeout_expired_file=$(_tmpdir)/expired
    rm -f "$timeout_expired_file"

    SECONDS=0
    output=$(DOT_TEST_TIMEOUT_EXPIRED_FILE="$timeout_expired_file" \
      _run_nvim_startup "$attempt_timeout" "$file" 2>&1)
    rc=$?
    elapsed=$SECONDS
    timed_out=0
    [[ -f "$timeout_expired_file" ]] && timed_out=1
    # A watchdog expiration consumes its requested child-runtime window.
    # Normalize integer-clock undercounting before sizing the retry.
    if [[ "$rc" -eq 124 && "$timed_out" -eq 1 &&
      "$elapsed" -lt "$attempt_timeout" ]]; then
      elapsed=$attempt_timeout
    fi
    total_elapsed=$((total_elapsed + elapsed))
    if [[ "$rc" -ne 0 ]]; then
      if [[ "$rc" -eq 124 && "$timed_out" -eq 1 && "$timeout_retried" -eq 0 ]]; then
        # Preserve the original uninterrupted 120-second preparation window.
        # A timed-out cold Lazy install gets one bounded recovery window because
        # its completed clones are reusable by the next process.
        timeout_retried=1
        deadline=$((deadline + 60))
        continue
      fi
      [[ "$timed_out" -eq 0 ]] ||
        echo "startup timed out after $attempt_timeout seconds"
      printf '%s\n' "$output"
      return "$rc"
    fi

    [[ -z "$budget" || "$elapsed" -le "$budget" ]] && return 0
  done
}

_assert_nvim_startup_budget() {
  local desc="$1" file="$2" budget
  local output rc elapsed nvim_session_state_dir startup_rc session_files
  budget=$(_nvim_startup_budget)

  # LazyVim may populate plugins on first launch; measure only after that
  # readiness process has completed successfully.
  output=$(_prepare_nvim_startup "$file" "$budget" 2>&1)
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    _fail "$desc preparation failed (exit $rc; output: $output)"
    return
  fi

  nvim_session_state_dir=$(_tmpdir)
  startup_rc=0
  XDG_STATE_HOME="$nvim_session_state_dir" \
    _run_nvim_startup 20 "$file" >/dev/null 2>&1 || startup_rc=$?
  _assert_eq "startup session isolation: nvim exits successfully" "0" "$startup_rc"
  session_files=$(fd --type f . "$nvim_session_state_dir/nvim/sessions" 2>/dev/null || true)
  _assert_eq "startup session isolation: nvim does not save a user session" "" "$session_files"

  SECONDS=0
  output=$(_run_nvim_startup 20 "$file" 2>&1)
  rc=$?
  elapsed=$SECONDS

  if [[ "$rc" -eq 0 && "$elapsed" -le "$budget" ]]; then
    _pass "$desc"
  else
    _fail "$desc (exit $rc after ${elapsed}s, budget ${budget}s; output: $output)"
  fi
}

# ---------------------------------------------------------------------------
# Tests: full nvim startup/shutdown smoke
# ---------------------------------------------------------------------------

echo "=== nvim: startup/shutdown performance ==="

startup_mock_dir=$(_tmpdir)
startup_mock_log="$startup_mock_dir/calls"
saved_run_nvim_startup=$(declare -f _run_nvim_startup)
_run_nvim_startup() {
  local timeout_seconds="$1"
  printf '%s\n' "$timeout_seconds" >>"$startup_mock_log"

  if [[ $(wc -l <"$startup_mock_log") -eq 1 ||
  "$startup_mock_timeout_kind" == watchdog-always ]]; then
    if [[ "$startup_mock_timeout_kind" == watchdog* &&
      -n "${DOT_TEST_TIMEOUT_EXPIRED_FILE:-}" ]]; then
      : >"$DOT_TEST_TIMEOUT_EXPIRED_FILE"
    fi
    return 124
  fi
  return 0
}
startup_mock_timeout_kind=watchdog
startup_rc=0
_prepare_nvim_startup "$HOME/.bashrc" "$(_nvim_startup_budget)" || startup_rc=$?
_assert_eq "startup preparation: recovers from one timeout" "0" "$startup_rc"
expected=$(printf '120\n60')
_assert_eq "startup preparation: preserves the original attempt before retrying" \
  "$expected" "$(cat "$startup_mock_log")"

: >"$startup_mock_log"
startup_mock_timeout_kind=watchdog-always
startup_rc=0
startup_output=$(_prepare_nvim_startup "$HOME/.bashrc" "$(_nvim_startup_budget)") ||
  startup_rc=$?
_assert_eq "startup preparation: a second timeout is terminal" "124" "$startup_rc"
_assert_eq "startup preparation: a terminal timeout says so" \
  "startup timed out after 60 seconds" "$startup_output"
_assert_file_content "startup preparation: timeout retry runs only once" \
  "$expected" "$startup_mock_log"

: >"$startup_mock_log"
startup_mock_timeout_kind=child
startup_rc=0
startup_output=$(_prepare_nvim_startup "$HOME/.bashrc" "$(_nvim_startup_budget)") ||
  startup_rc=$?
eval "$saved_run_nvim_startup"
_assert_eq "startup preparation: does not retry a child status 124" "124" "$startup_rc"
_assert_eq "startup preparation: a child status 124 is not called a timeout" \
  "" "$startup_output"
_assert_file_content "startup preparation: child status 124 runs once" "120" \
  "$startup_mock_log"

# Without a budget, the first successful start is ready however long it took.
# The stub fails any second start so a lost empty-budget check fails fast.
: >"$startup_mock_log"
_run_nvim_startup() {
  printf '%s\n' "$1" >>"$startup_mock_log"
  [[ $(wc -l <"$startup_mock_log") -eq 1 ]] || return 3
  sleep 1.1
}
startup_rc=0
_prepare_nvim_startup "" "" >/dev/null || startup_rc=$?
eval "$saved_run_nvim_startup"
_assert_eq "startup preparation: an empty budget accepts a slow first start" "0" "$startup_rc"
_assert_file_content "startup preparation: an empty budget starts once" "120" \
  "$startup_mock_log"

startup_args_dir=$(_tmpdir)
cat >"$startup_args_dir/nvim" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$@" >"$NVIM_TEST_ARGS_LOG"
EOF
chmod +x "$startup_args_dir/nvim"
NVIM_TEST_ARGS_LOG="$startup_args_dir/args" NVIM_TEST_BIN="$startup_args_dir/nvim" \
  _run_nvim_startup 20 ""
_assert_file_content "startup preparation: an empty file opens no buffer" \
  "$(printf '%s\n' -i NONE --headless --cmd "$NVIM_FULL_CONFIG_CMD" '+qa!')" \
  "$startup_args_dir/args"

# A failed lazy.nvim bootstrap clone must end a headless start with its error.
# Waiting for a keypress there blocked the cold-install start until the suite
# timeout, with no output. Run the checkout's real config.lazy from an empty
# data root against a Git that fails like an unreachable plugin source.
bootstrap_dir=$(_tmpdir)
mkdir -p "$bootstrap_dir/bin" "$bootstrap_dir/data" "$bootstrap_dir/config/nvim/lua/config"
ln -s "$(_nvim_repo_root)/home/.config/nvim/lua/config/lazy.lua" \
  "$bootstrap_dir/config/nvim/lua/config/lazy.lua"
printf 'require("config.lazy")\n' >"$bootstrap_dir/config/nvim/init.lua"
cat >"$bootstrap_dir/bin/git" <<'EOF'
#!/usr/bin/env sh
echo 'fatal: unable to access the plugin source' >&2
exit 128
EOF
chmod +x "$bootstrap_dir/bin/git"
bootstrap_rc=0
bootstrap_output=$(XDG_CONFIG_HOME="$bootstrap_dir/config" \
  XDG_DATA_HOME="$bootstrap_dir/data" PATH="$bootstrap_dir/bin:$PATH" \
  _with_timeout 30 "$NVIM_TEST_BIN" --headless -i NONE '+qa!' 2>&1) ||
  bootstrap_rc=$?
_assert_exit "startup preparation: a failed lazy.nvim clone exits headless Neovim" \
  1 "$bootstrap_rc"
_assert_contains "startup preparation: a failed lazy.nvim clone reports why" \
  "Failed to clone lazy.nvim:"$'\n'"fatal: unable to access the plugin source" \
  "$bootstrap_output"
_assert_not_contains "startup preparation: headless clone failure asks for no keypress" \
  "Press any key" "$bootstrap_output"

# Print the plugins the composed config declares but has not installed,
# comma-separated, or "lazy.nvim" when the plugin manager itself is absent.
# The regression harness below replaces this function before invoking it.
# shellcheck disable=SC2329
_nvim_full_config_uninstalled() {
  _with_timeout 60 "$NVIM_TEST_BIN" --headless -i NONE --cmd "$NVIM_FULL_CONFIG_CMD" \
    -u "$HOME/.config/nvim/init.lua" \
    -c 'lua local missing = {}; if vim.g.plugin_manager_missing then missing = { "lazy.nvim" } else for name, plugin in pairs(require("lazy.core.config").plugins) do if not plugin._.installed then missing[#missing + 1] = name end end end; table.sort(missing); io.stdout:write(table.concat(missing, ","))' \
    -c 'qa!' 2>/dev/null
}

# A private plugin copy cannot install, so a host without a converged plugin
# cache (or a branch adding a plugin the host has not installed) cannot run
# the full config. Skip those checks rather than fail on missing plugins.
_nvim_full_config_missing() {
  [[ $NVIM_TEST_PLUGIN_INSTALL_DISABLED == 1 ]] || return 0
  _nvim_full_config_uninstalled
}

# Make the composed config ready for the full-config checks, or set REPLY to
# why it is not and return 1. An explicit NVIM_TEST_DATA_HOME may start empty
# (installed-profile CI), so the first full-config start clones lazy.nvim and
# installs the whole plugin graph from the network. Make that start the
# bounded preparation step, which keeps Neovim's output: the checks have no
# deadline and discard their output, so a stalled or failed install there
# would silently consume the whole suite timeout. Opening no file keeps this
# start to what the first check loads. Lazy still exits 0 when a plugin fails
# to install, so afterwards turn installs off for every later start and
# require the graph to be complete. Runs in the caller's shell, because it
# extends NVIM_FULL_CONFIG_CMD.
_ready_nvim_full_config() {
  local output rc missing

  REPLY=
  output=$(_prepare_nvim_startup "" "" 2>&1) || {
    rc=$?
    REPLY="startup preparation failed (exit $rc; output: $output)"
    return 1
  }
  [[ $NVIM_TEST_PLUGIN_INSTALL_DISABLED == 1 ]] && return 0

  NVIM_FULL_CONFIG_CMD+='; vim.g.plugin_install_disabled = true'
  missing=$(_nvim_full_config_uninstalled) || {
    rc=$?
    REPLY="the installed-plugin query failed (exit $rc)"
    return 1
  }
  if [[ -n $missing ]]; then
    REPLY="startup preparation left plugins uninstalled: $missing"
    return 1
  fi
}

saved_prepare_nvim_startup=$(declare -f _prepare_nvim_startup)
saved_nvim_full_config_uninstalled=$(declare -f _nvim_full_config_uninstalled)
saved_nvim_full_config_cmd=$NVIM_FULL_CONFIG_CMD
saved_nvim_test_plugin_install_disabled=$NVIM_TEST_PLUGIN_INSTALL_DISABLED
ready_mock_log=$(_tmpfile)
_prepare_nvim_startup() {
  printf 'prepare %s|%s\n' "$1" "$2" >>"$ready_mock_log"
  printf '%s\n' "$ready_mock_prepare_output"
  return "$ready_mock_prepare_rc"
}
_nvim_full_config_uninstalled() {
  printf 'query %s\n' "$NVIM_FULL_CONFIG_CMD" >>"$ready_mock_log"
  printf '%s' "$ready_mock_missing"
}
_ready_case() {
  NVIM_TEST_PLUGIN_INSTALL_DISABLED=$1 ready_mock_prepare_rc=$2
  ready_mock_prepare_output=$3 ready_mock_missing=$4
  NVIM_FULL_CONFIG_CMD=base
  : >"$ready_mock_log"
  ready_rc=0
  _ready_nvim_full_config || ready_rc=$?
}

_ready_case 0 124 "startup timed out after 60 seconds" ""
_assert_eq "full-config readiness: a failed preparation is not ready" 1 "$ready_rc"
_assert_eq "full-config readiness: names the failed preparation and its output" \
  "startup preparation failed (exit 124; output: startup timed out after 60 seconds)" \
  "$REPLY"
_assert_file_content "full-config readiness: prepares once, with no file and no budget" \
  "prepare |" "$ready_mock_log"

_ready_case 0 0 "" "bar.nvim,foo.nvim"
_assert_eq "full-config readiness: an incomplete install is not ready" 1 "$ready_rc"
_assert_eq "full-config readiness: names the uninstalled plugins" \
  "startup preparation left plugins uninstalled: bar.nvim,foo.nvim" "$REPLY"

_ready_case 0 0 "" ""
_assert_eq "full-config readiness: a complete install is ready" 0 "$ready_rc"
_assert_file_content "full-config readiness: checks the graph with installs off" \
  "$(printf 'prepare |\nquery base; vim.g.plugin_install_disabled = true')" \
  "$ready_mock_log"
_assert_eq "full-config readiness: later starts cannot install" \
  "base; vim.g.plugin_install_disabled = true" "$NVIM_FULL_CONFIG_CMD"

_ready_case 1 0 "" ""
_assert_eq "full-config readiness: a private plugin copy is ready" 0 "$ready_rc"
_assert_file_content "full-config readiness: a private copy needs no install check" \
  "prepare |" "$ready_mock_log"
_assert_eq "full-config readiness: a private copy keeps its start command" \
  "base" "$NVIM_FULL_CONFIG_CMD"

eval "$saved_prepare_nvim_startup"
eval "$saved_nvim_full_config_uninstalled"
NVIM_FULL_CONFIG_CMD=$saved_nvim_full_config_cmd
NVIM_TEST_PLUGIN_INSTALL_DISABLED=$saved_nvim_test_plugin_install_disabled

full_config_missing=$(_nvim_full_config_missing)
if [[ -n $full_config_missing ]]; then
  echo "nvim-test: SKIP full-config checks; host plugin cache lacks $full_config_missing (run dot update)" >&2
  _pass "full-config startup skipped: host plugin cache lacks $full_config_missing"
elif ! _ready_nvim_full_config; then
  _fail "full-config checks did not run: $REPLY"
else
  import_order_result=$(_tmpfile)
  import_order_status=0
  NVIM_TEST_IMPORT_ORDER_FILE=$import_order_result \
    "$NVIM_TEST_BIN" --headless -i NONE \
    --cmd "$NVIM_FULL_CONFIG_CMD" \
    -u "$HOME/.config/nvim/init.lua" \
    -c 'lua local modules=require("lazy.core.config").spec.modules; local lazyvim_index, extras_index, plugins_index, overrides_index, policy_index, valid; valid=true; for index, module in ipairs(modules) do if module == "lazyvim.plugins" then lazyvim_index=index elseif module == "dotfiles.lazyvim_extras" then extras_index=index elseif module == "plugins" then plugins_index=index elseif module == "dotfiles.plugin_overrides" then overrides_index=index elseif module == "dotfiles.final_policy" then policy_index=index end end; valid=lazyvim_index == 1 and extras_index and plugins_index and overrides_index and policy_index and extras_index < plugins_index and plugins_index < overrides_index and overrides_index < policy_index; for index, module in ipairs(modules) do if module:match("^lazyvim%.plugins%.extras%.") and (not plugins_index or index > plugins_index) then valid=false end end; vim.fn.writefile({valid and "lazy-import-order-ok" or table.concat(modules, ",")}, vim.env.NVIM_TEST_IMPORT_ORDER_FILE)' \
    -c 'qa!' >/dev/null 2>&1 || import_order_status=$?
  _assert_eq "startup: LazyVim import-order probe exits successfully" \
    0 "$import_order_status"
  _assert_file_content "startup: LazyVim extras load before custom plugins" \
    "lazy-import-order-ok" "$import_order_result"

  if [[ -e $HOME/.config/nvim/lua/dotfiles/lazyvim_extras/dev.lua ]]; then
    _pass "editor-only startup smoke is covered by the editor fixture"
  else
    _assert_nvim_startup_budget "startup: .bashrc opens and exits within budget" "$HOME/.bashrc"

    result=$("$NVIM_TEST_BIN" --headless -i NONE \
      --cmd "$NVIM_FULL_CONFIG_CMD" \
      -u "$HOME/.config/nvim/init.lua" \
      -c 'lua local plugins=require("lazy.core.config").plugins; local names={"nvim-lspconfig","mason.nvim","mason-lspconfig.nvim","conform.nvim","nvim-lint","lazydev.nvim","nvim-dap","mason-nvim-dap.nvim","copilot.lua","none-ls.nvim"}; local active={}; for _, name in ipairs(names) do if plugins[name] then table.insert(active, name) end end; table.sort(active); local inventory={}; for name, plugin in pairs(plugins) do if plugin.dir then table.insert(inventory, name .. "\t" .. plugin.dir) end end; table.sort(inventory); if vim.env.NVIM_TEST_GRAPH_INVENTORY and vim.env.NVIM_TEST_GRAPH_INVENTORY ~= "" then vim.fn.writefile(inventory, vim.env.NVIM_TEST_GRAPH_INVENTORY) end; print(table.concat(active, ","))' \
      -c 'qa!' 2>&1)
    _assert_eq "editor plugin graph excludes development-only tooling" "" "$result"
    [[ -z ${NVIM_TEST_GRAPH_MARKER:-} ]] || : >"$NVIM_TEST_GRAPH_MARKER"

    # The VSCode-style keymaps are editor-owned, so an editor-only startup must
    # register them cleanly. Lazy only fires VeryLazy on UIEnter, which
    # headless Neovim never reaches, so trigger it directly. Match each mapping
    # by description, because LazyVim and plugins also claim some of these
    # keys. LazyVim catches a failing keymaps module, so re-require the domain
    # afterwards: a cached success returns at once, while a failed load raises
    # again and is reported. Only the domain is checked because the rest of
    # keymaps.lua needs Termnav, a base dependency the no-base owner fixture
    # (test/run) lacks.
    result=$("$NVIM_TEST_BIN" --headless -i NONE \
      --cmd "$NVIM_FULL_CONFIG_CMD" \
      -u "$HOME/.config/nvim/init.lua" \
      -c 'lua local problems={}; vim.api.nvim_exec_autocmds("User", { pattern = "VeryLazy", modeline = false }); for _, map in ipairs({ { "n", "<C-s>", "Save" }, { "n", "<S-Right>", "Select right" }, { "n", "<C-f>", "Find" }, { "n", "<F2>", "Rename symbol" } }) do if vim.fn.maparg(map[2], map[1], false, true).desc ~= map[3] then problems[#problems+1]="missing " .. map[1] .. map[2] end end; local ok, err = pcall(require, "config.keymaps.vscode"); if not ok then problems[#problems+1]=tostring(err):gsub("\n.*", "") end; print(table.concat(problems, "|"))' \
      -c 'qa!' 2>&1)
    _assert_eq "editor-only startup registers VSCode-style keymaps without errors" "" "$result"

    # Yanky normally loads on the first file open, so `p` in a buffer made
    # before that must load it on demand rather than do nothing. Clear
    # 'clipboard' so the put reads the test's register, not the host clipboard.
    result=$("$NVIM_TEST_BIN" --headless -i NONE \
      --cmd "$NVIM_FULL_CONFIG_CMD" \
      -u "$HOME/.config/nvim/init.lua" \
      -c 'lua vim.api.nvim_exec_autocmds("User", { pattern = "VeryLazy", modeline = false }); local yanky = require("lazy.core.config").plugins["yanky.nvim"]; local before = yanky._.loaded ~= nil; vim.o.clipboard = ""; vim.fn.setreg("\"", "XYZ"); vim.api.nvim_buf_set_lines(0, 0, -1, false, { "ab" }); vim.api.nvim_win_set_cursor(0, { 1, 1 }); vim.api.nvim_feedkeys("p", "xt", false); print(tostring(before) .. "|" .. vim.api.nvim_get_current_line() .. "|" .. tostring(yanky._.loaded ~= nil))' \
      -c 'qa!' 2>&1)
    _assert_eq "p before any file open loads Yanky and pastes at the cursor" \
      "false|aXYZb|true" "$result"
  fi

  # Loading a plugin makes lazy.nvim replace its spec-key stubs with real
  # mappings, which used to revert VSCode bindings set on VeryLazy. Load
  # every remaining plugin through the loader the key and event triggers
  # use, then require that no described global mapping changed or vanished.
  # Comparing every mapping keeps new plugins and keys covered without a
  # hand-maintained list. This and the next check run for every composed
  # config, not just the editor-only one, so hosts that add the dev or work
  # overlay also cover the keymaps and plugin specs those overlays bring.
  #
  # Findings go to a file rather than captured output: loading a plugin can
  # print notifications, and those are environment noise here. test/run's
  # controlled PATH has no treesitter build tools, so LazyVim reports unmet
  # requirements while nvim-treesitter still loads, and the no-base fixture
  # lacks the Termnav dependency config.autocmds needs. Neither changes a
  # mapping, so only a plugin that fails to load (its keys never applied)
  # fails the check alongside changed mappings. Plugins load one at a time
  # in name order so a raised error names its plugin and runs repeat
  # exactly.
  keymap_probe=$(_tmpdir)
  cat >"$keymap_probe/probe.lua" <<'EOF'
vim.api.nvim_exec_autocmds("User", { pattern = "VeryLazy", modeline = false })
local function snapshot()
  local maps = {}
  for _, mode in ipairs({ "n", "x", "s", "i", "o", "t", "c" }) do
    for _, map in ipairs(vim.api.nvim_get_keymap(mode)) do
      maps[mode .. " " .. map.lhs] = map.desc or ""
    end
  end
  return maps
end
local problems = {}
local before = snapshot()
-- Guard against a probe with nothing to compare: the VSCode-style keymaps
-- load in every profile, so their absence means the config did not start.
if before["n <C-S>"] ~= "Save" then
  problems[#problems + 1] = "VSCode-style keymaps did not load"
end
local plugins = require("lazy.core.config").plugins
local names = {}
for name, plugin in pairs(plugins) do
  if not plugin._.loaded then
    names[#names + 1] = name
  end
end
table.sort(names)
for _, name in ipairs(names) do
  local ok, err = pcall(require("lazy").load, { plugins = { name } })
  if not ok then
    problems[#problems + 1] = name .. " failed to load: " .. tostring(err):gsub("\n.*", "")
  elseif not plugins[name]._.loaded then
    problems[#problems + 1] = name .. " did not load"
  end
end
local after = snapshot()
for key, desc in pairs(before) do
  if desc ~= "" and after[key] ~= desc then
    problems[#problems + 1] = key .. "=" .. desc .. "->" .. tostring(after[key])
  end
end
table.sort(problems)
vim.fn.writefile({ table.concat(problems, "|") }, vim.env.NVIM_TEST_PROBE_FILE)
EOF
  _nvim_full_config_probe "$keymap_probe/result" "$keymap_probe/probe.lua"
  _assert_file_content "loading every plugin keeps the VSCode-style and other described mappings" \
    "" "$keymap_probe/result"

  # When two plugin specs claim one key, lazy.nvim keeps one stub until both
  # have loaded and then maps whichever plugin's key it removes last, so the
  # binding depends on load order. The check above misses that when the load
  # happens to end in the stub's favor, or when one claimant loads before
  # VeryLazy, so report every shared claim from the resolved specs; drop the
  # losing spec's key instead. Reading lazy.nvim internals, it also reports
  # finding no spec keys at all so a renamed field cannot pass silently.
  shared_probe=$(_tmpdir)
  cat >"$shared_probe/probe.lua" <<'EOF'
local claims, shared = {}, {}
for name, plugin in pairs(require("lazy.core.config").plugins) do
  for id in pairs(plugin._.handlers and plugin._.handlers.keys or {}) do
    claims[id] = claims[id] or {}
    table.insert(claims[id], name)
  end
end
for id, names in pairs(claims) do
  if #names > 1 then
    table.sort(names)
    shared[#shared + 1] = id .. "=" .. table.concat(names, ",")
  end
end
if next(claims) == nil then
  shared[#shared + 1] = "no plugin spec keys found"
end
table.sort(shared)
vim.fn.writefile({ table.concat(shared, "|") }, vim.env.NVIM_TEST_PROBE_FILE)
EOF
  _nvim_full_config_probe "$shared_probe/result" "$shared_probe/probe.lua"
  _assert_file_content "no key is claimed by more than one plugin spec" "" "$shared_probe/result"

  # lazy.nvim merges opts, keys, cmd, event, ft, and dependencies across the
  # specs that name one plugin, but `init`, `config`, and `build` are last
  # wins. A higher overlay that sets one of them for a plugin a lower overlay
  # or LazyVim already sets silently replaces that hook, which is how the dev
  # layer once dropped the editor's Ctrl-click mapping. Extend through an opts
  # function instead. Plain fields such as `lazy` or `enabled` are left out:
  # overriding those is the intended way to change a plugin's setup.
  override_probe=$(_tmpdir)
  cat >"$override_probe/probe.lua" <<'EOF'
local last_wins = { "init", "config", "build" }
local fragments = require("lazy.core.config").spec.meta.fragments.fragments
local sets, problems = {}, {}
for _, fragment in pairs(fragments) do
  local spec = type(fragment.spec) == "table" and fragment.spec or {}
  for _, field in ipairs(last_wins) do
    local value = rawget(spec, field)
    if value ~= nil then
      local key = fragment.name .. "." .. field
      sets[key] = sets[key] or {}
      table.insert(sets[key], value)
    end
  end
end
for key, values in pairs(sets) do
  -- Two specs repeating `config = true` agree; any function or differing
  -- value means one of them is discarded.
  local differs = false
  for _, value in ipairs(values) do
    if type(value) == "function" or value ~= values[1] then
      differs = true
    end
  end
  if #values > 1 and differs then
    problems[#problems + 1] = key
  end
end
if next(fragments) == nil then
  problems[#problems + 1] = "no lazy.nvim spec fragments found"
end
table.sort(problems)
vim.fn.writefile({ table.concat(problems, "|") }, vim.env.NVIM_TEST_PROBE_FILE)
EOF
  _nvim_full_config_probe "$override_probe/result" "$override_probe/probe.lua"
  _assert_file_content "no plugin init, config, or build hook is set by more than one spec" \
    "" "$override_probe/result"

  mason_probe=$(_tmpdir)
  cat >"$mason_probe/probe.lua" <<'EOF'
local plugins = require("lazy.core.config").plugins
vim.fn.writefile({ plugins["mason.nvim"] and "mason.nvim is enabled" or "" }, vim.env.NVIM_TEST_PROBE_FILE)
EOF
  _nvim_full_config_probe "$mason_probe/result" "$mason_probe/probe.lua"
  _assert_file_content "full-config runs never enable Mason tool installs" \
    "" "$mason_probe/result"
fi

