#!/bin/sh
printf '%s\n' "$*" >>"$REMOTE_OPEN_LOG"
case "$1" in
  link-host) printf 'devhost\n' ;;
  open-url) sleep 10 ;;
esac
EOF
chmod +x "$REMOTE_OPEN_TMP/slow/termnav"
