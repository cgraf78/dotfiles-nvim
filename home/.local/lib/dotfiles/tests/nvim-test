_remote_open_fake() {
  local dir="$REMOTE_OPEN_TMP/$1" open_url_status=$2
  mkdir -p "$dir"
  cat >"$dir/termnav" <<EOF
#!/bin/sh
printf '%s\n' "\$*" >>"\$REMOTE_OPEN_LOG"
case "\$1" in
  link-host) printf '%s\n' "\$REMOTE_OPEN_HOST" ;;
  open-url) exit $open_url_status ;;
  *) echo "termnav: unknown command: \$1" >&2; exit 2 ;;
esac
EOF
  chmod +x "$dir/termnav"
}
