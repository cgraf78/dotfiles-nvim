chmod +x "$REMOTE_OPEN_TMP/broken/termnav"

# Run one vim.ui.open call through the adapter with a stub original opener and
# print what happened: which opener answered, the arguments it saw, and every
# Termnav invocation in order.
_remote_open_case() {
  local bin=$1 host=$2 target=$3
  shift 3
  : >"$REMOTE_OPEN_LOG"
  (
    unset SSH_CONNECTION SSH_TTY VSCODE_IPC_HOOK_CLI TERM_PROGRAM TMUX TMUX_PANE
    for assignment in "$@"; do
      export "${assignment?}"
    done
    PATH="$REMOTE_OPEN_TMP/$bin:$DOT_TEST_SYSTEM_PATH" REMOTE_OPEN_HOST="$host" \
      REMOTE_OPEN_TARGET="$target" _nvim_lua '
      vim.ui.open = function(path, opt)
        print("original:" .. path .. ":" .. tostring(opt and opt.marker))
        return "original-process", nil
      end
      if vim.env.REMOTE_OPEN_ASSUME == "1" then
        vim.g.remote_open_assume_remote = true
      elseif vim.env.REMOTE_OPEN_ASSUME == "number" then
        vim.g.remote_open_assume_remote = 1
      end
      local opt = { marker = "opt" }
      if vim.env.REMOTE_OPEN_CMD then
        opt.cmd = { vim.env.REMOTE_OPEN_CMD }
      end
      local remote_open = dofile(vim.fn.expand("~/.config/nvim/lua/config/remote-open.lua"))
      remote_open.setup()
      local open = function()
        return vim.ui.open(vim.env.REMOTE_OPEN_TARGET, opt)
      end
      if vim.env.REMOTE_OPEN_FALLBACK then
        local inner = open
        open = function()
          return remote_open.fallback(inner)
        end
      end
      local process, err = open()
      if type(process) == "table" then
        print("forwarded:" .. process:wait(0).code .. ":" .. tostring(err))
      end
    '
  )
  # Headless print() leaves the final line unterminated.
  echo
  sed 's/^/termnav:/' "$REMOTE_OPEN_LOG"
}

